<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent">
 <ImageView android:id="@+id/widget_background" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/widget_background" android:importantForAccessibility="no"/>
 <LinearLayout android:id="@+id/widget_content" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp">
  <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:gravity="center_vertical">
   <ImageView android:id="@+id/widget_brand" android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/launcher_foreground" android:importantForAccessibility="no"/>
   <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="vertical">   <TextView android:fontFamily="@font/manrope_semibold" android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:text="Bolsillo" android:textSize="14sp" android:textColor="@color/widget_ink" android:maxLines="1" android:ellipsize="end"/>  <TextView android:fontFamily="@font/manrope_medium" android:id="@+id/widget_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Mi dinero" android:textSize="11sp" android:textColor="@color/widget_subtle" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false"/></LinearLayout>
   <ImageView android:id="@+id/widget_settings" android:layout_width="44dp" android:layout_height="match_parent" android:padding="12dp" android:contentDescription="Personalizar widget"/>
   <ImageView android:id="@+id/widget_refresh" android:layout_width="44dp" android:layout_height="match_parent" android:padding="12dp" android:contentDescription="Actualizar saldos locales"/>
  </LinearLayout>

  <TextView android:fontFamily="@font/manrope" android:id="@+id/widget_balance" android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginTop="2dp" android:text="$0" android:textSize="32sp" android:maxLines="1" android:ellipsize="end" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="14sp" android:autoSizeMaxTextSize="36sp" android:includeFontPadding="false" android:textColor="@color/widget_ink"/>
  <TextView android:fontFamily="@font/manrope" android:id="@+id/widget_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" android:textSize="11sp" android:textColor="@color/widget_subtle" android:maxLines="1" android:ellipsize="end"/>
  <LinearLayout android:id="@+id/widget_stats" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:visibility="visible"><LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
   <TextView android:id="@+id/widget_left_label" android:fontFamily="@font/manrope_medium" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Disponible" android:textSize="10sp" android:textColor="@color/widget_subtle" android:includeFontPadding="false" android:maxLines="1"/>
   <TextView android:id="@+id/widget_left_value" android:fontFamily="@font/manrope_semibold" android:layout_width="match_parent" android:layout_height="24dp" android:text="$0" android:textSize="14sp" android:textColor="@color/widget_ink" android:includeFontPadding="false" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="14sp"/>
  </LinearLayout><LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
   <TextView android:id="@+id/widget_right_label" android:fontFamily="@font/manrope_medium" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Ahorro" android:textSize="10sp" android:textColor="@color/widget_subtle" android:includeFontPadding="false" android:maxLines="1"/>
   <TextView android:id="@+id/widget_right_value" android:fontFamily="@font/manrope_semibold" android:layout_width="match_parent" android:layout_height="24dp" android:text="$0" android:textSize="14sp" android:textColor="@color/widget_ink" android:includeFontPadding="false" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="14sp"/>
  </LinearLayout></LinearLayout>
  <ImageView android:id="@+id/widget_flow" android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="3dp" android:scaleType="fitXY" android:visibility="gone" android:importantForAccessibility="no"/>
  <TextView android:fontFamily="@font/manrope" android:id="@+id/widget_updated" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="5dp" android:gravity="center_vertical" android:text="Saldo local" android:textSize="9sp" android:textColor="@color/widget_subtle" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false"/>
  <LinearLayout android:id="@+id/widget_actions" android:layout_width="match_parent" android:layout_height="44dp" android:gravity="center"><FrameLayout android:id="@+id/widget_expense_action" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"  android:contentDescription="Registrar gasto">
  <ImageView android:id="@+id/widget_expense_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/widget_button" android:importantForAccessibility="no"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center">
   <ImageView android:id="@+id/widget_expense_icon" android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ms_north_east" android:importantForAccessibility="no"/>
   <TextView android:fontFamily="@font/manrope_medium" android:id="@+id/widget_expense" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_marginStart="4dp" android:gravity="center" android:text="Gasto" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" android:textColor="@color/widget_accent"/>
  </LinearLayout></FrameLayout><FrameLayout android:id="@+id/widget_income_action" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginStart="6dp" android:contentDescription="Registrar ingreso">
  <ImageView android:id="@+id/widget_income_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/widget_button" android:importantForAccessibility="no"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center">
   <ImageView android:id="@+id/widget_income_icon" android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ms_south_west" android:importantForAccessibility="no"/>
   <TextView android:fontFamily="@font/manrope_medium" android:id="@+id/widget_income" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_marginStart="4dp" android:gravity="center" android:text="Ingreso" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" android:textColor="@color/widget_accent"/>
  </LinearLayout></FrameLayout><FrameLayout android:id="@+id/widget_move_action" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginStart="6dp" android:contentDescription="Registrar mover">
  <ImageView android:id="@+id/widget_move_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/widget_button" android:importantForAccessibility="no"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center">
   <ImageView android:id="@+id/widget_move_icon" android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ms_swap_horiz" android:importantForAccessibility="no"/>
   <TextView android:fontFamily="@font/manrope_medium" android:id="@+id/widget_move" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_marginStart="4dp" android:gravity="center" android:text="Mover" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" android:textColor="@color/widget_accent"/>
  </LinearLayout></FrameLayout></LinearLayout>
 </LinearLayout></FrameLayout>